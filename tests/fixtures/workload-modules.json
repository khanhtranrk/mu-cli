[
  {
    "name": "inline",
    "valid": true,
    "spec": {
      "workloads": {
        "w": {
          "target": "python",
          "argv": [
            "script.py"
          ],
          "units": 0
        }
      },
      "pipelines": {
        "p": {
          "prepare": [
            {
              "type": "ensure_workload",
              "workload": "w"
            }
          ],
          "nodes": [
            {
              "name": "n",
              "run": [
                {
                  "type": "execute_workload",
                  "workload": "w"
                }
              ]
            }
          ]
        }
      }
    }
  },
